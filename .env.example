# Set to the HTTPS origin printed after deploying wrangler.account.jsonc.
# Leave unset to keep account login hidden in the GitHub Pages website.
# VITE_WEB_ACCOUNT_API_ORIGIN=https://ak-randomizer-account.<your-subdomain>.workers.dev

# Enable the temporary original/compact progression icon comparison in a preview build.
# VITE_PROGRESSION_ICON_TESTER=true
