{
  "name": "arknights-randomizer",
  "version": "0.2.1",
  "private": true,
  "description": "Offline-first Arknights squad randomizer for Windows.",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run data:update:images && npm run build && electron-builder --dir --publish never",
    "build:win": "npm run data:update:images && npm run build && electron-builder --win --publish never",
    "data:update": "node scripts/update-operator-data.mts",
    "data:update:images": "node scripts/update-operator-data.mts --download-images && npm run data:portraits",
    "data:validate": "node scripts/validate-bundled-data.mts && node scripts/validate-portrait-coverage.mts",
    "build:portable": "npm run data:update:images && npm run build && electron-builder --win portable --publish never",
    "data:images": "node scripts/update-operator-data.mts --download-images-only && npm run data:portraits",
    "data:portraits": "node scripts/update-operator-portraits.mts",
    "benchmark": "vitest bench src/shared/randomizer.bench.ts"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.2.6",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.arknightsrandomizer.desktop",
    "productName": "Arknights Randomizer",
    "artifactName": "Arknights-Randomizer-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bundled-data",
        "to": "bundled-data"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Arknights-Randomizer-${version}-${arch}-Portable.${ext}"
    }
  }
}
