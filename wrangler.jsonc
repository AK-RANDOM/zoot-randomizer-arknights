{
  "name": "ak-randomizer",
  "main": "src/web/accountWorker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/web",
    "run_worker_first": ["/api/arknights/*"],
  },
  "ratelimits": [
    { "name": "ACCOUNT_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
  ],
  "vars": { "ACCOUNT_WEB_ORIGIN": "https://ak-random.github.io" },
  "observability": { "enabled": false },
}
